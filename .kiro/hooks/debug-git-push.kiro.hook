{
  "enabled": false,
  "name": "Debug Git Push Operations",
  "description": "Logs when PowerShell scripts are executed during git operations to help identify the source",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A shell command is about to be executed. If this is related to git push operations, please log the command details and help identify why PowerShell scripts are being triggered."
  }
}
