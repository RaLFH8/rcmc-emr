@echo off
echo ============================================
echo CLEARING BROWSER CACHE FOR RCMC EMR
echo ============================================
echo.
echo This will help fix the issue where deleted doctors
echo still appear in search results.
echo.
echo STEPS TO FIX:
echo.
echo 1. Close ALL browser windows
echo 2. Press Ctrl+Shift+Delete in your browser
echo 3. Select "Cached images and files"
echo 4. Select "All time" for time range
echo 5. Click "Clear data"
echo 6. Restart your browser
echo 7. Go to your EMR system
echo 8. Press Ctrl+F5 (hard refresh)
echo.
echo ============================================
echo ALTERNATIVE: Use Incognito/Private Mode
echo ============================================
echo.
echo Open your browser in Incognito/Private mode:
echo - Chrome: Ctrl+Shift+N
echo - Edge: Ctrl+Shift+P
echo - Firefox: Ctrl+Shift+P
echo.
echo This will load fresh data without cache.
echo.
pause
