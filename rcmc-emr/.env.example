# =====================================================
# RCMC EMR - Environment Configuration Template
# =====================================================
# COPY THIS FILE TO .env AND REPLACE WITH YOUR ACTUAL VALUES

# Supabase Database Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Configuration (for Lab Results)
VITE_API_URL=http://localhost:3003

# Google Drive Configuration (for Lab Results)
VITE_GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# =====================================================
# EMAIL NOTIFICATIONS (Resend)
# =====================================================
VITE_RESEND_API_KEY=your_resend_api_key
VITE_FROM_EMAIL=RCMC Clinic <your_email@domain.com>

# =====================================================
# SMS NOTIFICATIONS (TextBee - FREE with Philippine SIM)
# =====================================================
VITE_TEXTBEE_URL=http://192.168.0.108:5000
VITE_TEXTBEE_API_KEY=your_textbee_api_key