# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SMS Gateway Configuration (Optional - for automated SMS notifications)
# Get these from SMS Gateway for Android app: https://smsgateway.me
VITE_SMS_GATEWAY_API_KEY=your_api_key_here
VITE_SMS_GATEWAY_DEVICE_ID=your_device_id_here
VITE_SMS_GATEWAY_URL=https://smsgateway.me/api/v4/message/send

# Alternative: Semaphore SMS API (Philippines)
# VITE_SEMAPHORE_API_KEY=your_semaphore_api_key_here

# Email Notifications (Optional - Resend API)
# Sign up at https://resend.com (FREE: 100 emails/day, 3,000/month)
VITE_RESEND_API_KEY=your_resend_api_key_here
VITE_FROM_EMAIL=RCMC Clinic <noreply@yourdomain.com>

# Google Drive (for Lab Results)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
