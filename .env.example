# =====================================================
# RCMC EMR - Environment Variables for Cloudflare Pages
# =====================================================
# Copy these variable names into Cloudflare Pages:
# Dashboard → Pages → Your Project → Settings → Environment Variables
#
# DO NOT commit your actual .env file to Git.
# =====================================================

# Supabase (REQUIRED)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API for Lab Results (REQUIRED in production)
# Must be a publicly accessible URL — NOT localhost
# Options: Railway, Render, Fly.io, or any Node.js host
VITE_API_URL=https://your-backend-api.example.com

# Google Drive OAuth (for Lab Results file uploads)
VITE_GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email Notifications via Resend
VITE_RESEND_API_KEY=re_your_resend_api_key
VITE_FROM_EMAIL=RCMC Clinic <onboarding@resend.dev>

# SMS via TextBee (local Android gateway — NOT available in production)
# TextBee only works on the same local network as the Android device.
# For production SMS, consider Semaphore, Vonage, or Twilio.
VITE_TEXTBEE_URL=http://your-android-device-ip:5000
VITE_TEXTBEE_API_KEY=your-textbee-api-key
