# Vercel ignore file
# Files and directories to exclude from deployment

# Development files
.env
.env.local
.env.development
.env.test

# Test files
src/tests/
**/*.test.js
**/*.test.jsx
**/*.spec.js
**/*.spec.jsx
coverage/
.nyc_output/

# Documentation (optional - remove if you want docs deployed)
*.md
!README.md

# Development tools
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Build artifacts (these will be regenerated)
node_modules/
dist/
build/

# Git
.git/
.gitignore

# Backup files
backups/
*.backup
*.bak

# SQL files (keep schema but exclude data)
*.sql
!supabase-schema.sql

# Server files (not needed for frontend deployment)
server/

# Large assets (if any)
*.zip
*.tar.gz
*.rar

# IDE files
*.swp
*.swo
*~

# Local configuration
.env.production.local